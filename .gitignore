.env
.venv/
__pycache__/
*.pyc
node_modules/
projects/*/capture/
projects/*/render/
projects/*/audio/
projects/*/video_gen/
projects/*/review/
.pytest_cache/
dist/

# OS
.DS_Store

# Raw screen recordings and exports (hundreds of MB each)
Input/
Output/
*.mov
*.mkv

# Pipeline-created project workspaces with their own git repo (2.5 GB of captures/renders)
projects/artist-who-couldnt-create/
projects/demo/

# Footage copied into Remotion public/ and full-length YouTube downloads.
# Regenerable from Input/ or the source URLs, and many files exceed GitHub's 100 MB limit.
projects/**/public/clips/
projects/**/sources/

# Keep every other tracked file under 50 MB (GitHub warns at 50, rejects at 100).
# Add any new oversized file here by path.
projects/shorts/blender-vs-vi3w/ref/armor.mp4
projects/shorts/blender-vs-vi3w/ref/hair.mp4
projects/shorts/vi3w-memes/ref/bl-jet.mp4
projects/shorts/vi3w-memes/ref/bl-car.mp4
projects/shorts/roblox-hooks/06-deer-67/ref/hook-fill.mp4

# Rendered frame sequences in nested short projects (regenerable, ~1 GB per batch)
projects/**/render/

# Phone upload copies (duplicates of project out/ renders)
FinalUploads/

# Poly Haven CC0 cache (re-download: python -m reelforge.polyhaven kit)
assets/polyhaven/

# Rendered frame sequences, Blender autosave backups, re-encoded reference footage (regenerable)
projects/**/frames/
*.blend1
projects/**/ref/h264/

# Stray dir from an unformatted path string
%s/

